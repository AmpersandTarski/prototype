# note! also update .dockerignore
**/lib/
**/node_modules/
# The Ampersand compiler binary, downloaded into the repository root. Anchored with a
# leading slash: an unanchored 'ampersand' also matches the directory backend/src/Ampersand
# on a case-insensitive filesystem (macOS), which silently keeps new framework source files
# out of every commit.
/ampersand
/ampersand.exe

# Ignore dev stuff
.idea/
.DS_Store
**/.DS_Store
backend/generics/*.json
backend/generics/*.sql
html/
project/
.env
frontend/src/app/generated/project.module.ts

# this will be regenerated and copied to assets during the build phase, so don't check it in
frontend/src/assets/interfaces.son

# Cypress screenshots
frontend/cypress/screenshots/

# Gegenereerde prototype-output in test-projecten (compiler output, niet committen)
test/projects/**/.proto/
