CONTEXT SkipCleanConjuncts IN ENGLISH

-- Exercises every conjunct kind that the transaction close (re)evaluates, so that
-- test/projects/skip-clean-conjuncts/e2e/parity.mjs can compare the observable
-- behavior with transactions.skipCleanConjuncts off versus on (issue #443).

REPRESENT Name TYPE ALPHANUMERIC
RELATION guestName[Booking*Name] [UNI]
MEANING "The name of the guest for a booking."
RELATION confirmed[Booking*Booking] [PROP]
MEANING "A booking that has been confirmed."

-- Invariant: editing 'confirmed' on a nameless booking must roll back.
RULE ConfirmedNeedsName LABEL "Confirmed booking needs a guest name":
  confirmed |- guestName;guestName~
MEANING "A confirmed booking must have a guest name."
VIOLATION (TXT "Booking ", SRC I, TXT " is confirmed but has no guest name.")

-- ExecEngine rule: its fixpoint loop ends with a full evaluation of this conjunct,
-- which makes it "clean" at close — the exact case the skip setting targets.
RELATION allBookings[SESSION*Booking]
ROLE ExecEngine MAINTAINS ShowAllBookings
RULE ShowAllBookings: V[SESSION*Booking] |- allBookings
VIOLATION (TXT "{EX} InsPair;allBookings;SESSION;", SRC I, TXT ";Booking;", TGT I)

-- Signal rule: its violations reach the client via the violation cache, so a
-- stale skipped result would show up as a wrong or missing signal.
ROLE Anonymous MAINTAINS BookingNeedsName
RULE BookingNeedsName LABEL "Booking needs a guest name":
  I[Booking] |- guestName;guestName~
MEANING "Every booking should get a guest name."
VIOLATION (TXT "Booking ", SRC I, TXT " has no guest name yet.")

INTERFACE Overview FOR Anonymous : "_SESSION"[SESSION] cRud BOX<FORM>
  [ "Bookings" : allBookings CRUd BOX<TABLE>
      [ "Guest name" : guestName cRUd
      , "Confirmed"  : confirmed cRUd
      ]
  ]

POPULATION Booking CONTAINS [ "booking1", "booking2" ]

ENDCONTEXT
